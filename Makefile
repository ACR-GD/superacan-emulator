UNAME := $(shell uname -s)
SDL2_CFLAGS := $(shell sdl2-config --cflags)
SDL2_LIBS   := $(shell sdl2-config --libs)
ifneq ($(findstring Darwin,$(UNAME)),)
  CXX ?= clang++
  CC ?= clang
  SDL2_CFLAGS := $(shell /opt/homebrew/bin/sdl2-config --cflags 2>/dev/null || sdl2-config --cflags)
  SDL2_LIBS   := $(shell /opt/homebrew/bin/sdl2-config --libs 2>/dev/null || sdl2-config --libs)
  MACFLAGS := -mmacosx-version-min=12.0
endif
EXE :=
ifneq ($(findstring MINGW,$(UNAME))$(findstring MSYS,$(UNAME)),)
  EXE := .exe
  LDFLAGS_EXTRA := -static-libgcc -static-libstdc++
endif

CFLAGS   := -O3 -I./deps/musashi $(MACFLAGS) \
            -DM68K_EMULATE_010=M68K_OPT_OFF -DM68K_EMULATE_EC020=M68K_OPT_OFF \
            -DM68K_EMULATE_020=M68K_OPT_OFF -DM68K_EMULATE_030=M68K_OPT_OFF -DM68K_EMULATE_040=M68K_OPT_OFF \
            -DM68K_EMULATE_INT_ACK=M68K_OPT_ON -DM68K_EMULATE_PREFETCH=M68K_OPT_ON
CXXFLAGS := -MMD -MP -O3 -std=c++17 -I./src -I./deps/musashi $(SDL2_CFLAGS)
LDFLAGS  := $(SDL2_LIBS) $(LDFLAGS_EXTRA)

BUILD_DIR := build_obj
TARGET    := superacan-emu$(EXE)

# Musashi C sources
C_SRCS := deps/musashi/m68kcpu.c \
          deps/musashi/m68kops.c \
          deps/musashi/softfloat/softfloat.c

# Emulator C++ sources
CXX_SRCS := src/bus/bus.cpp \
            src/video/ppu.cpp \
            src/sound/apu.cpp \
            src/emu.cpp \
            src/config.cpp \
            src/savestate.cpp \
            src/main.cpp

C_OBJS   := $(patsubst %.c, $(BUILD_DIR)/%.o, $(C_SRCS))
CXX_OBJS := $(patsubst %.cpp, $(BUILD_DIR)/%.o, $(CXX_SRCS))

OBJS := $(C_OBJS) $(CXX_OBJS)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(OBJS) $(LDFLAGS) -o $@
	@echo "Build successful: $(TARGET)"

# Musashi's opcode tables are generated from m68k_in.c by its m68kmake tool.
deps/musashi/m68kops.c deps/musashi/m68kops.h: deps/musashi/m68k_in.c deps/musashi/m68kmake.c
	$(CC) -O2 -o deps/musashi/m68kmake deps/musashi/m68kmake.c
	cd deps/musashi && ./m68kmake . m68k_in.c

$(BUILD_DIR)/deps/musashi/%.o: deps/musashi/%.c deps/musashi/m68kops.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/src/%.o: src/%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD_DIR) $(TARGET) "$(APP_BUNDLE)" $(DMG)

# ── Native macOS app (AppKit frontend, no SDL) ───────────────────────────────
APP_NAME   := Super ACan Emulator
APP_BUNDLE := $(APP_NAME).app
APP_BIN    := $(BUILD_DIR)/SuperACan
CORE_SRCS  := src/bus/bus.cpp src/video/ppu.cpp src/sound/apu.cpp src/emu.cpp src/savestate.cpp
CORE_OBJS  := $(patsubst %.cpp, $(BUILD_DIR)/core/%.o, $(CORE_SRCS))
CORE_FLAGS := -MMD -MP -O3 -std=c++17 -I./src -I./deps/musashi -mmacosx-version-min=12.0
MAC_FRAMEWORKS := -framework Cocoa -framework QuartzCore -framework AudioToolbox \
                  -framework GameController -framework UniformTypeIdentifiers

$(BUILD_DIR)/core/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CORE_FLAGS) -c $< -o $@

$(BUILD_DIR)/mac/app.o: src/mac/app.mm src/emu.h src/savestate.h
	@mkdir -p $(dir $@)
	$(CXX) $(CORE_FLAGS) -fobjc-arc -Wall -Wno-unused-function -c $< -o $@

$(APP_BIN): $(C_OBJS) $(CORE_OBJS) $(BUILD_DIR)/mac/app.o
	$(CXX) $^ $(MAC_FRAMEWORKS) -mmacosx-version-min=12.0 -o $@

app: $(APP_BIN)
	./tools/make_app_bundle.sh "$(APP_BIN)" "$(APP_BUNDLE)"

run-app: app
	open "$(APP_BUNDLE)"

# Save-state determinism test (needs the Super Dragon Force ROMs from ../build)
TEST_PRG ?= ../build/Super-Dragon-Force_EN.bin
TEST_DAT ?= ../build/Super-Dragon-Force_DAT_EN.bin
$(BUILD_DIR)/savestate_test: tests/savestate_test.cpp $(C_OBJS) $(CORE_OBJS)
	$(CXX) $(CORE_FLAGS) $(filter %.cpp %.o,$^) -o $@

test: $(BUILD_DIR)/savestate_test
	@$(BUILD_DIR)/savestate_test "$(TEST_PRG)" "$(TEST_DAT)" save /tmp/sa_test.state | grep hash
	@$(BUILD_DIR)/savestate_test "$(TEST_PRG)" "$(TEST_DAT)" load /tmp/sa_test.state | grep hash

DMG := SuperACan-Emulator-3.0.dmg
dmg: app
	@rm -rf $(BUILD_DIR)/dmg "$(DMG)" && mkdir -p $(BUILD_DIR)/dmg
	@cp -R "$(APP_BUNDLE)" $(BUILD_DIR)/dmg/ && ln -s /Applications $(BUILD_DIR)/dmg/Applications
	@hdiutil create -volname "Super A'Can Emulator" -srcfolder $(BUILD_DIR)/dmg -ov -format UDZO "$(DMG)" >/dev/null
	@echo "Built $(DMG)"

.PHONY: all clean app run-app test dmg

# Header dependency tracking (generated by -MMD): rebuild objects when any header changes.
-include $(shell find $(BUILD_DIR) -name '*.d' 2>/dev/null)
