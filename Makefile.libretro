# libretro core (RetroArch).  make -f Makefile.libretro [platform=unix|osx|win]
# Android: ndk-build -C jni   (see jni/Android.mk)
ifeq ($(platform),)
  UNAME := $(shell uname -s)
  ifneq ($(findstring Darwin,$(UNAME)),)
    platform := osx
  else ifneq ($(findstring MINGW,$(UNAME))$(findstring MSYS,$(UNAME)),)
    platform := win
  else
    platform := unix
  endif
endif

TARGET_NAME := superacan
BUILD_DIR   := build_obj/libretro
CC  ?= cc
CXX ?= c++

ifeq ($(platform),osx)
  TARGET  := $(TARGET_NAME)_libretro.dylib
  SHARED  := -dynamiclib
  ARCHFLAGS := -mmacosx-version-min=10.13
else ifeq ($(platform),win)
  TARGET  := $(TARGET_NAME)_libretro.dll
  SHARED  := -shared -static -Wl,--no-undefined   # no MinGW runtime DLLs to ship with RetroArch
else
  TARGET  := $(TARGET_NAME)_libretro.so
  SHARED  := -shared -Wl,--no-undefined
  ARCHFLAGS := -fPIC
endif

include Makefile.common

FLAGS    := -O3 -fvisibility=hidden $(ARCHFLAGS) $(CORE_DEFINES) $(CORE_INCLUDES)
CFLAGS   += $(FLAGS)
CXXFLAGS += $(FLAGS) -std=c++17

OBJS := $(patsubst %.c,$(BUILD_DIR)/%.o,$(MUSASHI_SRCS)) $(patsubst %.cpp,$(BUILD_DIR)/%.o,$(LIBRETRO_SRCS))

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX) $(ARCHFLAGS) $(SHARED) $(OBJS) $(LDFLAGS) -o $@

$(BUILD_DIR)/%.o: %.c deps/musashi/m68kops.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.cpp deps/musashi/m68kops.h
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

# Musashi's opcode tables are generated by its m68kmake tool, built for the host.
HOSTCC ?= cc
deps/musashi/m68kops.c deps/musashi/m68kops.h: deps/musashi/m68k_in.c deps/musashi/m68kmake.c
	$(HOSTCC) -O2 -o deps/musashi/m68kmake deps/musashi/m68kmake.c
	cd deps/musashi && ./m68kmake . m68k_in.c

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

.PHONY: all clean
